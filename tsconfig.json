{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "sourceMap": true,
    "removeComments": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "baseUrl": "src",
    "paths": {
      "@/*": ["./*"],
      "three/addons/*": ["../node_modules/@types/three/examples/jsm/*"],
    },
    "types": ["webpack-env"],
    "skipLibCheck": true,
  },
  "exclude": ["editor"],
}